# ============================================
# 16. DECISION TREE CLASSIFIER (80/20 SPLIT)
# ============================================

from sklearn.tree import DecisionTreeClassifier, plot_tree
from sklearn.model_selection import train_test_split
from sklearn.metrics import (
    accuracy_score,
    classification_report,
    confusion_matrix,
    ConfusionMatrixDisplay
)
import matplotlib.pyplot as plt
import numpy as np

# 1. Find the closing price column
close_column = next(
    (col for col in df.columns
     if col.lower() in ["close", "closing price", "adj close", "adj_close"]),
    None
)

if close_column is None:
    raise ValueError(
        "No closing price column found. Check df.columns."
    )

# 2. Sort data chronologically
if "Date" in df.columns:
    df = df.sort_values("Date").reset_index(drop=True)

# 3. Create target:
# 1 = next available closing price increases
# 0 = next available closing price does not increase

df["Next_Close"] = df[close_column].shift(-1)

df["Target"] = (
    df["Next_Close"] > df[close_column]
).astype(int)

# Remove the final row because its next closing price is unknown
df = df.iloc[:-1].copy()

# 4. Select numerical features
# Use current-day values to predict the next day's direction.
possible_features = [
    "Open", "High", "Low", "Close",
    "Adj Close", "Adj_Close", "Volume"
]

feature_columns = [
    col for col in possible_features
    if col in df.columns
    and col.lower() not in ["next_close", "target"]
]

# Ensure the selected closing-price feature is included
if close_column not in feature_columns:
    feature_columns.append(close_column)

if len(feature_columns) == 0:
    raise ValueError("No suitable numerical stock features found.")

# Convert features to numeric and remove invalid rows
X = df[feature_columns].apply(
    lambda col: __import__("pandas").to_numeric(
        col, errors="coerce"
    )
)

y = df["Target"]

valid_rows = X.notna().all(axis=1) & y.notna()

X = X.loc[valid_rows]
y = y.loc[valid_rows]

# 5. Split chronologically: 80% train, 20% test
split_index = int(len(X) * 0.80)

X_train = X.iloc[:split_index]
X_test = X.iloc[split_index:]

y_train = y.iloc[:split_index]
y_test = y.iloc[split_index:]

print("===== TRAIN-TEST SPLIT =====")
print("Total samples:", len(X))
print("Training samples:", len(X_train))
print("Testing samples:", len(X_test))
print("Training percentage:", round(len(X_train) / len(X) * 100, 2), "%")
print("Testing percentage:", round(len(X_test) / len(X) * 100, 2), "%")

# 6. Create and train Decision Tree
model = DecisionTreeClassifier(
    max_depth=5,
    random_state=42,
    class_weight="balanced"
)

model.fit(X_train, y_train)

# 7. Make predictions
y_pred = model.predict(X_test)

# 8. Evaluate model
print("\n===== DECISION TREE RESULTS =====")

accuracy = accuracy_score(y_test, y_pred)
print("Accuracy:", round(accuracy * 100, 2), "%")

print("\nClassification Report:")
print(
    classification_report(
        y_test,
        y_pred,
        labels=[0, 1],
        target_names=["No Increase", "Increase"],
        zero_division=0
    )
)

# 9. Confusion Matrix
cm = confusion_matrix(y_test, y_pred, labels=[0, 1])

display_matrix = ConfusionMatrixDisplay(
    confusion_matrix=cm,
    display_labels=["No Increase", "Increase"]
)

display_matrix.plot(cmap="Blues")
plt.title("Decision Tree Confusion Matrix")
plt.show()

# 10. Feature Importance
importance = __import__("pandas").DataFrame({
    "Feature": X.columns,
    "Importance": model.feature_importances_
}).sort_values("Importance", ascending=False)

print("\n===== FEATURE IMPORTANCE =====")
print(importance)

plt.figure(figsize=(9, 5))
plt.barh(
    importance["Feature"],
    importance["Importance"]
)
plt.xlabel("Importance")
plt.ylabel("Feature")
plt.title("Decision Tree Feature Importance")
plt.gca().invert_yaxis()
plt.tight_layout()
plt.show()

# 11. Visualize Decision Tree
plt.figure(figsize=(20, 10))

plot_tree(
    model,
    feature_names=list(X.columns),
    class_names=["No Increase", "Increase"],
    filled=True,
    rounded=True,
    fontsize=8
)

plt.title("TXRH Stock Decision Tree")
plt.show()

print("\nDecision Tree training and evaluation completed.")



from sklearn.metrics import accuracy_score

y_pred = model.predict(X_test)

accuracy = accuracy_score(y_test, y_pred)

print(f"Decision Tree Model Accuracy: {accuracy * 100:.2f}%")



# Display 10 actual records and their predictions

import pandas as pd
from sklearn.metrics import accuracy_score

# Select the first 10 records from the test dataset
X_10 = X_test.iloc[:10]
y_10_actual = y_test.loc[X_10.index]

# Predict using the trained Decision Tree model
y_10_predicted = model.predict(X_10)

# Create results table
results = pd.DataFrame({
    "Actual Direction": y_10_actual.map({
        0: "No Increase",
        1: "Increase"
    }).values,
    "Predicted Direction": pd.Series(y_10_predicted).map({
        0: "No Increase",
        1: "Increase"
    }).values,
    "Correct Prediction": (
        y_10_actual.to_numpy() == y_10_predicted
    )
})

# Add original dates, if available
if "Date" in df.columns:
    results.insert(
        0,
        "Date",
        df.loc[X_10.index, "Date"].dt.strftime("%Y-%m-%d").values
    )

# Display actual closing prices
close_col = next(
    (c for c in df.columns
     if c.lower() in ["close", "closing price", "adj close", "adj_close"]),
    None
)

if close_col:
    results["Actual Closing Price"] = (
        df.loc[X_10.index, close_col].values
    )
    results["Next Closing Price"] = (
        df.loc[X_10.index, "Next_Close"].values
    )

print("10 Actual Records and Decision Tree Predictions:")
display(results)

print(
    "Accuracy on 10 records:",
    f"{accuracy_score(y_10_actual, y_10_predicted) * 100:.2f}%"
)





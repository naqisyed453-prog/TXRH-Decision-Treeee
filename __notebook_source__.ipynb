        volume_column = column
        break

if volume_column:

    # Divide data into volume categories
    df["Volume_Category"] = pd.qcut(
        df[volume_column],
        q=4,
        labels=[
            "Low Volume",
            "Medium-Low Volume",
            "Medium-High Volume",
            "High Volume"
        ],
        duplicates="drop"
    )

    volume_counts = df["Volume_Category"].value_counts()

    plt.figure(figsize=(8, 8))

    plt.pie(
        volume_counts.values,
        labels=volume_counts.index,
        autopct="%1.1f%%",
        startangle=90
    )

